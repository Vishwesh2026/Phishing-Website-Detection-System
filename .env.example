# ─────────────────────────────────────────────────────────────
# .env.example
# Copy to .env and fill in values before running.
# ─────────────────────────────────────────────────────────────

# App
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Model versioning
# v1 = standard deep model (~50k dataset)
# clean_v1 = robust deep model (~235k dataset, recommended)
MODEL_VERSION=clean_v1
MODEL_DIR=models

# Security
MAX_REQUEST_BODY_BYTES=8192
# Use * for all origins, or comma-separated: https://app.com,https://other.com
ALLOWED_ORIGINS=*

# Gunicorn
GUNICORN_WORKERS=5
