{
    "manifest_version": 3,
    "name": "Phishing Detector Pro",
    "description": "Real-time ML-powered phishing detection with confidence scoring",
    "version": "2.0",
    "permissions": [
        "tabs",
        "activeTab",
        "notifications",
        "storage"
    ],
    "host_permissions": [
        "http://127.0.0.1:8000/*",
        "https://your-production-api.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Phishing Detector Pro",
        "default_popup": "popup.html"
    }
}